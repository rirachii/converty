{
  "name": "converty",
  "version": "0.1.0",
  "description": "Local file conversion tools with a native macOS app and a preserved web edition.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rirachii/converty.git"
  },
  "bugs": {
    "url": "https://github.com/rirachii/converty/issues"
  },
  "homepage": "https://github.com/rirachii/converty#readme",
  "scripts": {
    "dev": "vite",
    "prepare:engines": "node scripts/prepare-engines.mjs",
    "postinstall": "npm run prepare:engines",
    "build": "npm run prepare:engines && npm run prepare:source && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "prepare:source": "node scripts/prepare-source.mjs",
    "predev": "npm run prepare:source"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.43.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
